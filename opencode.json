{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mcp-video": {
      "type": "local",
      "command": ["npx", "-y", "@studiomeyer/mcp-video"]
    },
    "open-computer-use": {
      "type": "local",
      "command": ["open-computer-use", "mcp"]
    },
    "supabase": {
      "type": "local",
      "command": ["npx", "-y", "@supabase/mcp-server-supabase"]
    },
    "agent-bridge": {
      "type": "remote",
      "url": "http://localhost:3721/mcp",
      "enabled": true
    }
  }
}
